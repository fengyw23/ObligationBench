+
+// decodeRecord accepts current byte values and legacy string values.
+func decodeRecord(doc *firestore.DocumentSnapshot, r *record) error {
+	if err := doc.DataTo(r); err == nil {
+		return nil
+	}
+	var legacy struct {
+		Key       string `firestore:"key,omitempty"`
+		Timestamp int64  `firestore:"timestamp,omitempty"`
+		Expires   int64  `firestore:"expires,omitempty"`
+		ID        int64  `firestore:"id,omitempty"`
+		Value     string `firestore:"value,omitempty"`
+	}
+	if err := doc.DataTo(&legacy); err != nil {
+		return err
+	}
+	*r = record{Key: legacy.Key, Timestamp: legacy.Timestamp, Expires: legacy.Expires, ID: legacy.ID, Value: []byte(legacy.Value)}
+	return nil
+}
