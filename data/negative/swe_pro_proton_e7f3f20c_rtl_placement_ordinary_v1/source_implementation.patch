+export const getPhysicalPlacement = (placement: PopperPlacement, rtl: boolean): PopperPlacement => {
+    if (!rtl) return placement;
+    switch (placement) {
+        case 'top-start':
+            return 'top-end';
+        case 'top-end':
+            return 'top-start';
+        case 'bottom-start':
+            return 'bottom-end';
+        case 'bottom-end':
+            return 'bottom-start';
+        default:
+            return placement;
+    }
+};
